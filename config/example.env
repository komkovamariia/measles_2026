# New 2026 FASTQ batch on Aldan-3
export MEASLES_NEW_FASTQ_DIR=/projects/mice_transplant_2025/raw/20260817_161454/Fastq

# Old UDP0097-UDP0112 cohort is required for the complete analysis.
# run_all_from_scratch.sh and run_slurm.sh try to locate pe150_res automatically.
# Set this explicitly if automatic discovery fails.
# export MEASLES_LEGACY_FASTQ_DIR=/projects/.../pe150_res

# Confirmed/default human DNA multiplex preset used by this project.
export MEASLES_MIXCR_PRESET=milab-human-dna-tcr-multiplex
export MEASLES_REQUIRE_ALL_INPUTS=1
